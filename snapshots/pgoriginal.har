ponent=\"cart\" data-cart-open-type=\"show_notification\" data-modal-url=\"modal-fullscreen-cart\">\n        <form action=\"/comprar/\" method=\"post\" class=\"js-ajax-cart-panel h-100 \" data-store=\"cart-form\">\n                        <div class=\"js-modal-close js-fullscreen-modal-close  modal-header  \">\n                                            <div class=\"row no-gutters align-items-center\">\n                            <div class=\"col p-3 text-center\">\n                                \t\t\tCarrito de compras\t\t                            </div>\n                            <div class=\"col-auto\">\n                                <a class=\"js-modal-close modal-close\">\n                                    <svg class=\"icon-inline icon-lg svg-icon-text\"><use xlink:href=\"#times\"/></svg>\n                                </a>\n                            </div>\n                        </div>\n                                    </div>\n                <div class=\"modal-body h-100\">\n                    \t\t\t\n\n\n\n                                                            <div\n                class=\"js-visible-on-cart-filled js-nubesdk-slot\"\n                data-nubesdk-slot=\"before_line_items\"\n                                                                                style=\"display:none;\"\n                            ></div>\n            \n\n<div class=\"js-ajax-cart-list\">\n        </div>\n\n\n\n\n\n                                                            <div\n                class=\"js-visible-on-cart-filled js-nubesdk-slot\"\n                data-nubesdk-slot=\"after_line_items\"\n                                                                                style=\"display:none;\"\n                            ></div>\n            \n\n<div class=\"js-empty-ajax-cart\" >\n \t    <div class=\"alert alert-info text-center\" data-component=\"cart.empty-message\">El carrito de compras está vacío. </div>\n</div>\n<div id=\"error-ajax-stock\" style=\"display: none;\">\n\t<div class=\"alert alert-warning m-3\">\n     \t¡Uy! No tenemos más stock de este producto para agregarlo al carrito. Si querés podés<a href=\"/productos/\" class=\"btn-link font-small ml-1\">ver otros acá</a>\n    </div>\n</div>\n\n<div class=\"cart-row\">\n    \n\n\n    \n\n\n  \n    \n        \t\n<div class=\"js-visible-on-cart-filled\" style=\"display: none;\">\n\t<div class=\"js-fulfillment-info js-allows-non-shippable\" style=\"display: none\">\n\t\t\t\t\t\t\n<div class=\"js-ship-free-rest progress-bar mt-2 mb-5 pb-1\">\n\t<div class=\"progress-bar-title-container\">\n\t\t<div class=\"js-ship-free-rest-message ship-free-rest-message progress-bar-title\">\n\t\t\t\t\t\t<div class=\"ship-free-rest-text bar-progress-success\">\n\t\t\t\t¡Genial! Tenés envío gratis\t\t\t</div>\n\t\t\t<div class=\"ship-free-rest-text bar-progress-amount\">\n\t\t\t\t¡Estás a <span class=\"js-ship-free-dif\"></span> de tener envío gratis!\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"ship-free-rest-text bar-progress-condition\">\n\t\t\t\t\tEnvío gratis superando los $120.000\t\t\t\t</div>\n\t\t\t\t\t\n\t\t</div>\n\t\t\t</div>\n\t\t<div class=\"js-bar-progress bar-progress\">\n\t\t<div class=\"js-bar-progress-active bar-progress-active transition-soft\" style=\"width: 0%;\">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"js-bar-progress-check bar-progress-check transition-soft\">\n\t\t\t\t\t\t\t\t\t<svg class=\"icon-inline\"><use xlink:href=\"#check\"/></svg>\n\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n</div>\n\n\t</div>\n</div>\n\n  \n\n<div class=\"js-subtotal-price subtotal-price hidden\" data-priceraw=\"0\"></div>\n\n<div id=\"store-curr\" class=\"hidden\">ARS</div>\n\n\n\n\n\n  \n  <div class=\"mb-3\">\n    <div class=\"js-visible-on-cart-filled row font-weight-normal\" style=\"display:none;\" data-store=\"cart-subtotal\">\n      <span class=\"col-7\">\n        <span class=\"font-weight-bold\">Subtotal</span>\n        \n        <small class=\"js-subtotal