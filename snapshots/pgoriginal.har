     "content": {
      "size": -1,
      "mimeType": "application/javascript",
      "text": "(function () {\n    let shopIdRV = 0;\n\tlet typeShop= \"tiendanube\";\n    if(window.LS && window.LS.hasOwnProperty('store'))\n\t\t{shopIdRV = window.LS.store.id;\n\t\tif(window.LS.theme.code == 'patagonia') shopIdRV = 0;\n\t}\n\telse if(window.RevieConfig){\n\t\tconst {store,type,locale,version} = window.RevieConfig || {};\n\t\ttypeShop = type;\n\t\tshopIdRV=store;\n\t}else{\n\t\tconst headScripts = document.head.querySelectorAll('script'); \n\t\tconst scriptSources = Array.from(headScripts).map(script => script.src);\n\t\tif(!getShop(scriptSources)){\n\t\t\tconst bodyScripts = document.body.querySelectorAll('script'); \n\t\t\tconst scriptSourcesBody = Array.from(bodyScripts).map(script => script.src);\n\t\t\tif(!getShop(scriptSourcesBody)){\n\t\t\t\tconsole.log(\"I don't store in REVIE\");\n\t\t\t}\n\t\t}\n\t}\n    let versionRV = \"\";\n\tlet statusRV = \"\";\n    function injectScriptRV(src) {\n        return new Promise((resolve, reject) => {\n            const script = document.createElement('script');\n            script.src = src;\n            script.addEventListener('load', resolve);\n            script.addEventListener('error', e => reject(e.error));\n            document.head.appendChild(script);\n        });\n    }\n    \n    async function getData(url) {\n\t\ttry {\n\n\t\t\tlet json = null;\n\t\t\tconst promise = new Promise(resolve => {\n\t\t\tfetch(url)\n\t\t\t.then((response) => {if (response?.ok) {return response.json()}else{resolve();}})\n\t\t\t.then((data) => {json= data; resolve();})\n\t\t\t.catch((error) => resolve());\n\t\t\t});\n\t\t\tawait promise;\n\n\t\t\tif(json && json.id){\n\t\t\t\tversionRV = json.id;\n\t\t\t\twindow.versionRV = versionRV;\n\t\t\t\t\n\t\t\t\tstatusRV = json.status;\n\t\t\t\twindow.statusRV = statusRV;\n\t\t\t\t\n\t\t\t\tabortRV = json.abort || 0;\n\t\t\t\twindow.abortRV = abortRV;\n\t\t\t\t\n\t\t\t\tif (abortRV == 1) {\n\t\t\t\t\tconsole.log(\"REVIE ABORTED\");\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\twidgetsVersionRV = json.version || 1;\n\t\t\t\twindow.widgetsVersionRV = widgetsVersionRV;\n\t\t\t\t\n\t\t\t\tif (statusRV == \"failed\") {\n\t\t\t\t\tconsole.log(\"I don't pay REVIE\");\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\tif (widgetsVersionRV == 2) {\n\t\t\t\t\tconsole.log(\"REVIE widgets v2\");\n\t\t\t\t\tloadWidgetsV2();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tawait checkReviewCache();\n\t\t\t}else{\n\t\t\t\tconst response = await fetch(\"https://tiendanube.triciclogo.com/js/?store=\"+shopIdRV+\"&update=yes\");\n\t\t\t\tawait response.text();\n\t\t\t}\n\t\t\tinjectRV(\"https://revie-wwwstatic.b-cdn.net/js/\"+shopIdRV+\".js?v=\"+versionRV);\n\t\t\tvar cssId = 'revieCss';\n\t\t\tvar head  = document.getElementsByTagName('head')[0];\n\t\t\tvar link  = document.createElement('link');\n\t\t\tlink.id   = cssId;\n\t\t\tlink.rel  = 'stylesheet';\n\t\t\tlink.type = 'text/css';\n\t\t\tlink.href = 'https://revie-wwwstatic.b-cdn.net/css/'+shopIdRV+'.css?v='+versionRV;\n\t\t\tlink.media = 'all';\n\t\t\thead.appendChild(link);\n\t\t} catch (error) {\n\t\t\tconsole.error(error);\n\t\t}\n    }\n\t\n\tfunction getShop(scriptSources){\n\t\tfor (let i = 0; i < scriptSources.length; i++) {\n\t\t  let url = scriptSources[i];\n\t\t  if (url.startsWith(\"https://revie-wwwstatic.b-cdn.net/admin/admin.js\")){\n\t\t\tconst urlParams = new URLSearchParams(url);\n\t\t\tconsole.log(\"url\", url);\n\t\t\tconsole.log(\"urlParams.get\", urlParams.get('store'));\n\t\t\tshopIdRV = urlParams.get('store');\n\t\t\tlet typeShopCopy = urlParams.get('type'); \n\t\t\tif(typeShopCopy != null){\n\t\t\t\ttypeShop = typeShopCopy;\n\t\t\t}\n\t\t\treturn true;\t\t\t\n\t\t  }\n\t\t}\n\t\treturn false;\n\t}\n    \n    \n    function injectRV(src) {\n        //https://revie-wwwstatic.b-cdn.net/admin/?store=2686675\n        injectScriptRV(src)\n            .then(() => {\n                console.log('Script loaded!');\n            }).catch(error => {\n                console.error(error);\n        });\n    }\n\tfunction loadWidgetsV2() {\n\t\tvar CDN = 'https://revie-wwwstatic.b-cdn.net/widgets-new';\n\t\tvar storeId = String(shopIdRV);\n\t\tvar bust = Math.floor(Date.now() / 60000);\n\t\tdelete window.__RevieV;\n\t\tvar vs = document.createElement('script');\n\t\tvs.src = CDN + '/version/' + storeId + '.js?_=' + bust;\n\t\tvs.onload = function() {\n\t\t\tvar v = window.__RevieV;\n\t\t\tconsole.log('[Revie] versión:', v);\n\t\t\tvar cs = document.createElement('script');\n\t\t\tcs.src = CDN + '/js/' + storeId + '.js?v=' + (v && v.version);\n\t\t\tcs.onload = function() {\n\t\t\t\tif (typeof window.revieBoot === 'function') {\n\t\t\t\t\twindow.revieBoot();\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error('[Revie] revieBoot no está definido');\n\t\t\t\t}\n\t\t\t};\n\t\t\tcs.onerror = function() { console.error('[Revie] error cargando widgets v2'); };\n\t\t\tdocument.head.appendChild(cs);\n\t\t};\n\t\tvs.onerror = function() { console.error('[Revie] error cargando version v2'); };\n\t\tdocument.head.appendChild(vs);\n\t}\n\n\tasync function checkReviewCache() {\n\t\ttry {\n\t\t\tconst cacheUrl = `https://revie-reviewcache.b-cdn.net/${typeShop}/${shopIdRV}/${shopIdRV}-products.txt`;\n\t\t\t\n\t\t\tconst res = await fetch(cacheUrl);\n\n\t\t\tif (res.ok) {\n\t\t\t\tconst data = await res.text();\n\t\t\t\twindow.revieProductCache = data;\n\t\t\t\tconsole.log(\"REVIE cache loaded\");\n\t\t\t} else if (res.status === 404) {\n\t\t\t\tconsole.log(\"REVIE cache not found → triggering backend\");\n\n\t\t\t\tfetch(`https://app.revie.ai/api/widget/abort?store=${shopIdRV}&type=${typeShop}`, {\n\t\t\t\t\tmethod: \"POST\"\n\t\t\t\t}).catch(() => {});\n\t\t\t}\n\n\t\t} catch (e) {\n\t\t\tconsole.log(\"REVIE cache error\");\n\t\t}\n\t}\n\t\n    if(shopIdRV !== 0){\n\t\twindow.revietypeShop = typeShop;\n        getData(\"https://revie-wwwstatic.b-cdn.net/admin/\"+typeShop+\"/\"+shopIdRV+\".txt?id=\"+Math.random(0,5555555555));\n    }\n})();"
