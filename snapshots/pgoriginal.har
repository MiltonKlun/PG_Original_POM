      "mimeType": "text/html; charset=UTF-8",
      "text": "<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:fb=\"http://www.facebook.com/2008/fbml\" xmlns:og=\"http://opengraphprotocol.org/schema/\" lang=\"es\">\n    <head>\n        <link rel=\"preconnect\" href=\"https://acdn-us.mitiendanube.com\" />\n        <link rel=\"dns-prefetch\" href=\"https://acdn-us.mitiendanube.com\" />\n        <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n        <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n        <title>Iniciar Sesión - PG Original Ind</title>\n        <meta name=\"description\" content=\"\" />\n        <link rel=\"preload\" as=\"style\" href=\"//fonts.googleapis.com/css?family=Big+Shoulders+Display:400,700|Chivo:400,700&amp;display=swap\" />\n        <link rel=\"preload\" href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/baires/dart-style-critical-f26d42fa098142f031c03b4b363ba70a.css\" as=\"style\" />\n        <link rel=\"preload\" href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/baires/dart-external-no-dependencies-2020a4748d2e0fc983451e7972c49502.js\" as=\"script\" />\n\n        \n        \n        \n<meta property=\"og:site_name\" content=\"PG Original Ind\" />\n\n\n<meta property=\"fb:app_id\" content=\"107147892676939\" />\n\n\n\n\n\n\n\n\n\n\n\n        \n        <style>\n            \n            \n\n\n\n    \n    @import url('//fonts.googleapis.com/css?family=Big+Shoulders+Display:400,700|Chivo:400,700&display=swap');\n\n \n\n            \n            \n:root {\n\n  \n  \n  \n    \n  \n      \n    \n  \n    \n    \n  \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n  \n  \n  --main-foreground: #000000;\n  --main-background: #FFFFFF;\n\n  --accent-color: #000000;