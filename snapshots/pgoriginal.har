oreground-opacity-10: 1A;\n\n  --adbar-foreground-opacity-10: #FFFFFF1A;\n\n  --main-categories-foreground-opacity-20: main_foreground33;\n\n  --brands-foreground-opacity-10: 1A;\n\n  --institutional-foreground-opacity-90: E6;\n\n  --news-foreground-opacity-30: #0000004D;\n  --news-foreground-opacity-80: #000000CC;\n\n  --footer-foreground-opacity-10: #FFFFFF1A;\n  --footer-foreground-opacity-20: #FFFFFF33;\n  --footer-foreground-opacity-50: #FFFFFF80;\n  --footer-foreground-opacity-60: #FFFFFF99;\n  --footer-foreground-opacity-80: #FFFFFFCC;\n\n  \n  --success: #4bb98c;\n  --danger: #dd7774;\n  --warning: #dc8f38;\n\n  \n  \n  --heading-font: \"Big Shoulders Display\", sans-serif;\n  --body-font: \"Chivo\", sans-serif;\n\n  \n  \n  \n  --h1-huge: 100px;\n  --h1-extra-huge-md: 600px;\n  --h1-huge-md: 125px;\n  --h2-huge: 70px;\n  --h2-extra-huge-md: 200px;\n  --h3-huge: 50px;\n  --h4-huge: 40px;\n\n  \n  \n  --h1: 28px;\n  --h2: 24px;\n  --h3: 20px;\n  --h4: 18px;\n  --h5: 16px;\n  --h6: 14px;\n  --h6-small: 12px;\n\n  \n  \n  --font-huge: 32px;\n  --font-extra-largest: 28px;\n  --font-extra-large: 24px;\n  --font-largest: 20px;\n  --font-large: 18px;\n  --font-big: 16px;\n  --font-base: 14px;\n  --font-medium: 11px;\n  --font-small: 12px;\n  --font-smallest: 10px;\n\n  \n  \n  --title-font-weight: bold;\n\n  \n  \n  --main-text-transform: uppercase;\n\n  \n  \n  --gutter: 15px;\n  --gutter-container: 15px;\n  --gutter-container-md: 30px;\n  --gutter-negative: calc(var(--gutter) * -1);\n  --gutter-half: calc(var(--gutter) / 2);\n  --gutter-half-negative: calc(var(--gutter) * -1 / 2);\n  --gutter-double: calc(var(--gutter) * 2);\n\n  \n  \n  --border-radius: 4px;\n  --border-radius-full: 100%;\n  --border-radius-half: calc(var(--border-radius) / 2);\n  --border-radius-quarter: calc(var(--border-radius) / 4);\n  --border-solid: 1px solid;\n  --border-dashed: 1px dashed;\n\n  \n  --shadow-distance: 0 0 5px;\n\n  \n  --section-distance: 30px;\n  --section-distance-huge: 60px;\n  --section-distance-huge-md: 90px;\n  --section-negative-distance: calc(var(--section-distance) * -1);\n\n}        </style>\n\n        \n        <link rel=\"stylesheet\" type=\"text/css\" href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/baires/dart-style-critical-f26d42fa098142f031c03b4b363ba70a.css\" media=\"all\" />\n\n        \n        <link rel=\"stylesheet\" href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/baires/dart-style-async-1c447763268271a0a1d243fdbbb9e28b.css\" media=\"print\" onload=\"this.media='all'\">\n\n        \n        <style>\n            \n        </style>\n\n        \n        \n        \n        \n        \n        \n        \n        \n        \n\n\n    <link href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/common/logo-842565847-1753807470-564b934bed9f85ea99873d98ef49375d1753807470.ico?0\" class=\"js-favicon\" rel=\"icon\" type=\"image/x-icon\" />\n    <link href=\"//acdn-us.mitiendanube.com/stores/693/159/themes/common/logo-842565847-1753807470-564b934bed9f85ea99873d98ef49375d1753807470.ico?0\" class=\"js-favicon\" rel=\"shortcut icon\" type=\"image/x-icon\" />\n<link rel=\"canonical\" href=\"\" />\n\n<meta name=\"nuvempay-logo\" content=\"//d26lpennugtm8s.cloudfront.net/assets/common/img/logos/payment/new_logos_payment/nuvempago@2x.png\" />\n    <meta name=\"facebook-domain-verification\" content=\"ufk1jwvyuoomhojq1rtsxvn3ihu6zq\" />\n\n<script>\n    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n            n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n            n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n            t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,\n        document,'script','https://connect.facebook.net/en_US/fbevents.js');\n\n        \n    const tnTrackCookie = document.cookie.match('(^|;) ?tn_track=([^;]*)(;|$)')?.[2].slice(-40).toLowerCase();\n    const partnerAgentIdentifier = 'tiendanube\\u002Dcore';\n    const advancedMatchingConfig = {};\n\n    if (tnTrackCookie) {\n        advancedMatchingConfig.external_id = tnTrackCookie;\n    }\n\n    const pixelId = '260193131258697';\n\n    fbq('init', pixelId, advancedMatchingConfig);\n    fbq('set', 'agent', partnerAgentIdentifier, pixelId);\n\n    \n                fbq('track', 'PageView');\n    \n</script>\n<noscript>\n    <img height=\"1\" width=\"1\" style=\"display:none\" src=\"https://www.facebook.com/tr?id=260193131258697&ev=PageView&noscript=1\"/>\n</noscript>\n\n\n\n\n    <script type=\"text/javascript\" id=\"nube-sdk-script\">\n    (function() {\n        'use strict';\n\n        window.addEventListener('nubesdk:internal-error', function(event) {\n            var detail = (event && event.detail) || {};\n            console.error('[NubeSDK internal error]', detail.source, detail.code, detail.message);\n            if (window.DD_RUM && typeof window.DD_RUM.addError === 'function') {\n                window.DD_RUM.addError(\n                    new Error(detail.message || 'NubeSDK internal error'),\n                    { source: detail.source, code: detail.code, origin: 'nubesdk' }\n                );\n            }\n        });\n\n        function initNubeSDK() {\n            if (typeof window.NubeSDKPreact === 'undefined') {\n                return false;\n            }\n\n            const { Loader, Runtime, render, Slot, h } = window.NubeSDKPreact;\n\n            const root = document.getElementById('nubesdk-root');\n            if (!root) {\n                return false;\n            }\n\n            const loaderElement = Loader({\n                hostId: 'storefront',\n                initialState: {\n                    location: {\n    page: {\n        type: \"account.login\",\n        data: {\n            customerId: null,\n            loggedIn: false        }\n    },\n    queries: {}\n}\n,\ncart: {\n    id: null,\n    items: [\n            ],\n    prices: {\n        discount_coupon: 0,\n        discount_gateway: 0, // only known once a payment method is selected at checkout\n        discount_promotion: 0,\n        shipping: 0,\n        subtotal: 0,\n        subtotal_without_taxes: 0,\n        total: 0\n    },\n    validation: {\n        status: \"pending\"\n    },\n    coupon: {\n        code: \"\",\n        type: \"\",\n        value: \"\",\n    }\n},\nstore: {\n    id: 693159,\n    name: \"PG\\u0020Original\\u0020Ind\",\n    currency: \"ARS\",\n    currency_details: {\n        code: \"ARS\",\n        cents_separator: \",\",\n        thousands_separator: \"\",\n        display_long: \"\\u0024\\u0020ARS\",\n        display_short: \"\\u0024\"\n    },\n    domain: \"pgoriginalind.mitiendanube.com\",\n    language: \"es\",\n    theme: \"baires\",\n    quick_cart: true,\n    state_level: \"full\" // \"minimal\" | \"light\" | \"full\"\n},\ncustomer: {}                },\n                apps: [\n                                            {\n            id: \"2910\",\n            script: \"https\\u003A\\/\\/apps\\u002Dscripts.tiendanube.com\\/crossup\\u002Dflowy\\/store\\u002Dsdk\\/39.js\\u003FversionId\\u003D2ubL4j.50B4wt.DbHMhfKUmhQpo6jCEw\\u0026store\\u003D693159\"\n        }\n                    ,        {\n            id: \"5178\",\n            script: \"https\\u003A\\/\\/apps\\u002Dscripts.tiendanube.com\\/cheguei\\u002Davise\\u002Dme\\/cheguei\\u002Dalertas\\/2.js\\u003FversionId\\u003D3eSXXdD5176zweLktvqbnP9t2jrmxe6w\\u0026store\\u003D693159\"\n        }\n                            ],\n                withTelemetry: true            });\n            render(loaderElement, root);\n\n            const runtimeRoot = document.getElementById('nubesdk-runtime');\n            if (runtimeRoot) {\n                const runtimeElement = h(Runtime, { hostId: 'storefront' });\n                render(runtimeElement, runtimeRoot);\n            }\n\n            var UNMOUNTED_NUBESDK_SLOT_SELECTOR = '.js-nubesdk-slot:not([data-nubesdk-mounted])';\n\n            // Registry of the slots present on the page, read by apps through the\n            // AvailableSlots host commands (see nubesdk-available-slots-commands.js).\n            window.__NUBE_SDK_AVAILABLE_SLOTS__ = window.__NUBE_SDK_AVAILABLE_SLOTS__ || { static: [], dynamic: [] };\n\n            function registerAvailableSlot(slotRoot, slotId, pick) {\n                var sectionType = slotRoot.getAttribute('data-nubesdk-section-type');\n                if (sectionType !== null) {\n                    // data-nubesdk-slot already holds the full \"<prefix>_<section_id>\"\n                    // name (composed in nubesdk-slot.tpl), so it is the slotId as-is.\n                    var dynamicType = slotId.indexOf('after_dynamic_section') === 0\n                        ? 'after_dynamic_section'\n                        : 'before_dynamic_section';\n                    window.__NUBE_SDK_AVAILABLE_SLOTS__.dynamic.push({\n                        type: dynamicType,\n                        sectionType: sectionType,\n                        sectionId: slotRoot.getAttribute('data-nubesdk-section-id'),\n                        sectionIndex: Number(slotRoot.getAttribute('data-nubesdk-section-index')),\n                        slotId: slotId\n                    });\n                } else {\n                    window.__NUBE_SDK_AVAILABLE_SLOTS__.static.push({\n                        slotId: slotId,\n                        pick: pick,\n                        isRepeatable: pick !== null\n                    });\n                }\n            }\n\n            function renderNubeSDKSlots() {\n                var unmounted = document.querySelectorAll(UNMOUNTED_NUBESDK_SLOT_SELECTOR);\n                unmounted.forEach(function(slotRoot) {\n                    var slotId = slotRoot.getAttribute('data-nubesdk-slot');\n                    var dataSlotPick = slotRoot.getAttribute('data-nubesdk-slot-pick');\n                    if (slotId) {\n                        var slotProps = { id: slotId };\n                        if (dataSlotPick) {\n                            slotProps.pick = dataSlotPick;\n                        }\n                        render(h(Slot, slotProps), slotRoot);\n                        slotRoot.setAttribute('data-nubesdk-mounted', 'true');\n                        registerAvailableSlot(slotRoot, slotId, dataSlotPick);\n                    }\n                });\n            }\n\n            function elementSubtreeMayHaveUnmountedSlot(el) {\n                if (el.matches && el.matches(UNMOUNTED_NUBESDK_SLOT_SELECTOR)) {\n                    return true;\n                }\n                return !!(el.querySelector && el.querySelector(UNMOUNTED_NUBESDK_SLOT_SELECTOR));\n            }\n\n            function addedSubtreeMayHaveUnmountedSlot(node) {\n                if (!node) {\n                    return false;\n                }\n                var ELEMENT_NODE = 1;\n                var DOCUMENT_FRAGMENT_NODE = 11;\n                if (node.nodeType === ELEMENT_NODE) {\n                    return elementSubtreeMayHaveUnmountedSlot(node);\n                }\n                if (node.nodeType === DOCUMENT_FRAGMENT_NODE) {\n                    var children = node.childNodes;\n                    for (var c = 0; c < children.length; c++) {\n                        if (addedSubtreeMayHaveUnmountedSlot(children[c])) {\n                            return true;\n                        }\n                    }\n                }\n                return false;\n            }\n\n            var scheduleSlotsRaf =\n                window.requestAnimationFrame ||\n                function(cb) {\n                    return setTimeout(cb, 0);\n                };\n            var slotRenderScheduled = false;\n\n            function scheduleRenderNubeSDKSlots() {\n                if (slotRenderScheduled) {\n                    return;\n                }\n                slotRenderScheduled = true;\n                scheduleSlotsRaf(function() {\n                    slotRenderScheduled = false;\n                    renderNubeSDKSlots();\n                });\n            }\n\n            renderNubeSDKSlots();\n\n            var observer = new MutationObserver(function(mutations) {\n                for (var i = 0; i < mutations.length; i++) {\n                    var added = mutations[i].addedNodes;\n                    if (added.length === 0) {\n                        continue;\n                    }\n                    for (var j = 0; j < added.length; j++) {\n                        if (addedSubtreeMayHaveUnmountedSlot(added[j])) {\n                            scheduleRenderNubeSDKSlots();\n                            return;\n                        }\n                    }\n                }\n            });\n            observer.observe(document.body, { childList: true, subtree: true });\n        }\n\n        function initNubeSDKWhenReady() {\n            delete window.initNubeSDKWhenReady;\n            if (document.readyState === 'loading') {\n                document.addEventListener('DOMContentLoaded', function() {\n                    initNubeSDK();\n                });\n            } else {\n                initNubeSDK();\n            }\n        }\n\n        window.initNubeSDKWhenReady = initNubeSDKWhenReady;\n    })();\n</script>\n<script\n    src=\"https://nsk-cdn-static.tiendanube.com/vanilla-adapter-0.26.0.min.js\"\n    crossorigin=\"anonymous\"\n    fetchpriority=\"high\"\n    onload=\"initNubeSDKWhenReady()\"\n    async\n></script>\n\n\n<script type=\"text/javascript\">\n    var LS = LS || {};\n    LS.store = {\n        id : 693159,\n        url : \"pgoriginalind.mitiendanube.com\",\n        custom_url : \"www.pgoriginal.com\",\n        ga4_measurement_id : \"\",\n        gads_measurement_id : \"\",\n        has_preexisting_google_mc_catalog : false,\n        has_google_analytics_track_product_ids : false,\n        should_group_kits_for_analytics : false,\n        skip_ga4_frontend_analytics : false,\n        skip_gads_frontend_analytics : false,\n        name: \"PG\\u0020Original\\u0020Ind\",\n        has_kits_v2: false,\n        nube_sdk_product_state: \"full\",\n    };\n    LS.cart = {\n        id : null,\n        hash : null,\n        subtotal : 0,\n        has_non_shippable_products: false,\n        has_shippable_products: false,\n        items : [\n                    ],\n        grouped_items : [\n                    ],\n        analytics_items: [\n                    ]\n    };\n    LS.hasCartMinimumValue = false;\n    LS.abStorefrontCartExperiments = null;\n    LS.lang = \"es_AR\";\n    LS.langCode = \"es\";\n    LS.currency = {\n        code : \"ARS\",\n        display_short: \"\\u0024\",\n        display_long: \"\\u0024\\u0020ARS\",\n        cents_separator : \",\",\n        thousands_separator : \"\"\n    };\n    LS.country = \"AR\";\n                LS.customer = null;\n    LS.customerHasPriceTables = false;\n    LS.template= \"account.login\";\n    LS.isPreview = false;\n    LS.theme = {\n        code: \"baires\",\n        name: \"Baires\",\n        custom: false,\n            };\n    LS.metricsWorkerScriptUrl = \"https://acdn-us.mitiendanube.com/assets/stores/js/metrics-worker-c984926f96a2e4787f155a9755d6944a30.js?v=94973530\"\n\n    LS.socialScripts = [];\n    LS.DOMReady = function(fn) {\n        if (document.addEventListener) {\n            document.addEventListener('DOMContentLoaded', fn);\n        } else {\n            document.attachEvent('onreadystatechange', function() {\n                if (document.readyState === 'interactive')\n                    fn();\n            });\n        }\n    };\n\n    // Making it a thenable so it can be made into a full fledged Promise later\n    LS._readyCallbacks = [];\n    LS.ready = {\n        then: function(callback){\n            LS._readyCallbacks.push(callback);\n        }\n    };\n\n    window.addEventListener('load', () => {\n        if(!window.cartService) {\n            return;\n        }\n\n        window.cartService.setCurrentLoadTime(1790693798);\n    });\n\n    window.pageData = {\n        id: \"\",\n        name: \"\"\n    }\n\n    window.initialCart = {\"id\":null,\"subtotal\":0,\"total\":0,\"discounts\":0,\"promotions\":[],\"shipping_zipcode\":null};\n\n    window.metricServiceDispatchQueue = [];\n    window.metricService = { dispatch: (event) => window.metricServiceDispatchQueue.push(event) };\n\n    window.translations = {\n        cart: {\n            error_messages: {\n                out_of_stock: 'No hay más stock de este producto.',\n                unavailable_product: 'Este producto no está disponible.',\n                update_error: 'Ocurrió un error al actualizar el carrito.',\n                subscription_only_product: 'Este producto solo está disponible para suscripciones.',\n                subscription_item_already_in_cart: 'Este producto ya se encuentra en el carrito.',\n                subscription_limit_reached: 'Solo podés agregar un producto por suscripción al carrito.'\n            },\n            name: 'Carrito de compras'\n        }\n    };\n</script>\n\n\n                        <link rel=\"preconnect\" href=\"https://challenges.cloudflare.com\" crossorigin>\n        <script>\n            window.turnstileEnabled = true;\n            window.turnstileConfig = { siteKey: '0x4AAAAAACiLhFoGwsoxGiTp' };\n            // Per-endpoint-group opt-in. register/reset_password require only\n            // the master tag above. contact/newsletter forms consult these\n            // flags to decide whether to render the Turnstile widget or fall\n            // back to reCAPTCHA.\n            window.turnstileEndpoints = {\n                contact: true,\n                newsletter: false\n            };\n        </script>\n                <script>\n            window.recaptchaEnabled = true;\n            window.recaptchaV2 = { siteKey: '6Ldp6lUqAAAAAEmZBhIVl_tzMi70KlSohR77QfLc' };\n            wind